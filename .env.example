# URL of the Bambuddy API as reachable from the importer container.
# Examples: http://host.docker.internal:<port> or http://<bambuddy-service>:<port>
BAMBUDDY_URL=

# Bambuddy API key with Manage Library permission.
BAMBUDDY_API_KEY=

# Long, unique password for the importer web interface.
IMPORTER_PASSWORD=

# Optional Thingiverse App Token. Leave empty to disable Thingiverse imports.
THINGIVERSE_TOKEN=

# Optional settings
IMPORTER_IMAGE=ghcr.io/rupp3r/bambuddy-model-importer:latest
IMPORTER_PORT=8097
MAX_DOWNLOAD_MB=512
