# URL of the Bambuddy API as reachable from the importer container.
BAMBUDDY_URL=

# Bambuddy API key with Manage Library permission.
BAMBUDDY_API_KEY=

# Long, unique password for the importer web interface.
IMPORTER_PASSWORD=

# Optional Thingiverse App Token. This requires a Thingiverse developer account.
# The Internet Archive Thingiverse collection does not need this token.
THINGIVERSE_TOKEN=

# Optional settings
IMPORTER_IMAGE=ghcr.io/rupp3r/bambuddy-model-importer:latest
IMPORTER_PORT=8097
MAX_DOWNLOAD_MB=512
